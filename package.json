{
  "name": "po-generator",
  "version": "1.0.0",
  "description": "CLI tool for automated Page Object generation using AI",
  "type": "module",
  "bin": {
    "po-gen": "./bin/po-gen.ts"
  },
  "scripts": {
    "start": "node --import tsx bin/po-gen.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.3.1",
    "openai": "^4.20.0",
    "ora": "^8.0.0",
    "playwright": "^1.40.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "playwright",
    "page-object",
    "testing",
    "automation",
    "ai",
