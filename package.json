{
  "name": "po-generator",
  "version": "1.0.0",
  "description": "CLI tool for automated Page Object generation using AI",
  "type": "module",
  "bin": {
    "po-gen": "./bin/po-gen.ts"
  },
  "scripts": {
    "start": "node --import tsx bin/po-gen.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.2.3",
    "openai": "^6.17.0",
    "ora": "^9.1.0",
    "playwright": "^1.58.1",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "playwright",
    "page-object",
    "testing",
    "automation",
    "ai",
    "vuetify",
    "symfony"
  ],
  "author": "",
  "license": "MIT"
}
