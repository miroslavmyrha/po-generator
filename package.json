{
  "name": "po-generator",
  "version": "1.0.0",
  "description": "CLI tool for automated Page Object generation using AI",
  "type": "module",
  "bin": {
    "po-gen": "./bin/po-gen.ts"
  },
  "scripts": {
    "start": "node --import tsx bin/po-gen.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "openai": "^6.49.0",
    "ora": "^9.4.1",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "playwright",
    "page-object",
    "testing",
    "automation",
    "ai",
    "vuetify",
    "symfony"
  ],
  "author": "",
  "license": "MIT"
}
